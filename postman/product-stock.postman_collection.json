{
  "info": {
    "_postman_id": "70da626f-ac62-4fe1-956b-e945f697d41b",
    "name": "Product Stock Management",
    "description": "Create a product, update its stock quantity, retrieve the product, and delete it. Requests use the ID returned during creation and check response status codes and stock quantities.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "productId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Create product",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test(\"Product ID and Location are returned\", function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.id).to.be.a(\"number\").and.above(0);",
              "    pm.expect(pm.response.headers.get(\"Location\")).to.include(\"/api/products/\" + body.id);",
              "    pm.collectionVariables.set(\"productId\", String(body.id));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/products",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "products"
          ]
        },
        "description": "Create a product with stockQuantity 10 and save its ID.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Desk Lamp\",\n  \"description\": \"Dimmable LED desk lamp\",\n  \"price\": 24.95,\n  \"category\": \"Office\",\n  \"stockQuantity\": 10\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "Update stock quantity",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Stock quantity is zero\", function () {",
              "    pm.expect(pm.response.json().stockQuantity).to.eql(0);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/products/{{productId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "products",
            "{{productId}}"
          ]
        },
        "description": "Update the product with stockQuantity 0 to mark it out of stock.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Adjustable Desk Lamp\",\n  \"description\": \"Updated lamp with adjustable arm\",\n  \"price\": 34.5,\n  \"category\": \"Lighting\",\n  \"stockQuantity\": 0\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "Get product",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Requested product is returned\", function () {",
              "    pm.expect(String(pm.response.json().id)).to.eql(pm.collectionVariables.get(\"productId\"));",
              "});",
              "pm.test(\"Stock quantity is zero\", function () {",
              "    pm.expect(pm.response.json().stockQuantity).to.eql(0);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/products/{{productId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "products",
            "{{productId}}"
          ]
        },
        "description": "Retrieve the product and check its stored stock quantity."
      },
      "response": []
    },
    {
      "name": "Delete product",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 204\", function () {",
              "    pm.response.to.have.status(204);",
              "});",
              "pm.test(\"Response body is empty\", function () {",
              "    pm.expect(pm.response.text()).to.eql(\"\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/products/{{productId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "products",
            "{{productId}}"
          ]
        },
        "description": "Delete the product created by this collection."
      },
      "response": []
    }
  ]
}
