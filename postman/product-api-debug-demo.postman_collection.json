{
  "info": {
    "_postman_id": "70da626f-ac62-4fe1-956b-e945f697d41b",
    "name": "Product API - Zero Stock Debugging Demo",
    "description": "Run in order to create a product with stock 10, set stock to zero, retrieve it, and clean up. Assertions express the intended API contract: a valid zero stock update should be saved and returned. Compare the PUT and GET responses while debugging.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "demoProductId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Create product with stock 10",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test(\"Product ID and Location are returned\", function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.id).to.be.a(\"number\").and.above(0);",
              "    pm.expect(pm.response.headers.get(\"Location\")).to.include(\"/api/products/\" + body.id);",
              "    pm.collectionVariables.set(\"demoProductId\", String(body.id));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/products",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "products"
          ]
        },
        "description": "Create an independent demo product with stockQuantity 10 and save its ID.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Desk Lamp\",\n  \"description\": \"Dimmable LED desk lamp\",\n  \"price\": 24.95,\n  \"category\": \"Office\",\n  \"stockQuantity\": 10\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "Set stock to zero",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Stock quantity is zero\", function () {",
              "    pm.expect(pm.response.json().stockQuantity).to.eql(0);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/products/{{demoProductId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "products",
            "{{demoProductId}}"
          ]
        },
        "description": "Mark the created product sold out by sending stockQuantity 0. Expect 200 and a response with stockQuantity 0.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Adjustable Desk Lamp\",\n  \"description\": \"Updated lamp with adjustable arm\",\n  \"price\": 34.5,\n  \"category\": \"Lighting\",\n  \"stockQuantity\": 0\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "Verify persisted stock is zero",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Requested product is returned\", function () {",
              "    pm.expect(String(pm.response.json().id)).to.eql(pm.collectionVariables.get(\"demoProductId\"));",
              "});",
              "pm.test(\"Stock quantity is zero\", function () {",
              "    pm.expect(pm.response.json().stockQuantity).to.eql(0);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/products/{{demoProductId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "products",
            "{{demoProductId}}"
          ]
        },
        "description": "Read the same product after the update. Its persisted stockQuantity should be 0."
      },
      "response": []
    },
    {
      "name": "Delete demo product",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 204\", function () {",
              "    pm.response.to.have.status(204);",
              "});",
              "pm.test(\"Response body is empty\", function () {",
              "    pm.expect(pm.response.text()).to.eql(\"\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/products/{{demoProductId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "products",
            "{{demoProductId}}"
          ]
        },
        "description": "Clean up the demo product. Run Create again for another debugging attempt."
      },
      "response": []
    }
  ]
}
